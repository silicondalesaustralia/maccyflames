---
const title = 'Macclesfield Netball Club | Coming Soon';
const description = 'Home of the Macclesfield Flames. Our new website is coming soon.';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/logo.png', Astro.site)} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;500&display=swap"
    />
    <link rel="canonical" href={Astro.site} />
  </head>
  <body>
    <main>
      <img src="/logo.png" alt="Macclesfield Netball Flames logo" width="425" height="425" />
      <h1>Coming Soon</h1>
      <p>The new home of Macclesfield Netball Club is on its way.</p>
    </main>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    min-height: 100%;
    background: #000;
    color: #fff;
    font-family: 'Montserrat', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
</style>

<style>
  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    box-sizing: border-box;
  }
  img {
    width: min(80vw, 360px);
    height: auto;
  }
  h1 {
    margin: 1.5rem 0 0.5rem;
    font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
    font-weight: 400;
    font-size: clamp(3rem, 10vw, 5.5rem);
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffd200;
  }
  p {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #e6e6e6;
  }
</style>
